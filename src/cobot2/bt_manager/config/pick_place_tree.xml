<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
    <!-- ////////// -->
    <BehaviorTree ID="BehaviorTree">
        <Fallback name="PickAndPlaceRoot">
            <Sequence name="MainTask">
                <Action ID="SearchTarget" target_name="{target_item}"/>
                <Action ID="PickItem" target_name="{target_item}"/>
            </Sequence>
            <Sequence name="RecoveryTask">
                <Action ID="ClearAlarm"/>
                <Action ID="ResetPose"/>
            </Sequence>
        </Fallback>
    </BehaviorTree>
    <!-- ////////// -->
    <TreeNodesModel>
        <Action ID="ClearAlarm"/>
        <Action ID="PickItem">
            <input_port name="target_name"/>
        </Action>
        <Action ID="ResetPose"/>
        <Action ID="SearchTarget">
            <input_port name="target_name"/>
        </Action>
    </TreeNodesModel>
    <!-- ////////// -->
</root>
